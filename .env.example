NEXT_PUBLIC_SITE_URL=https://phoenixfireplace.ca
# Canonical customer portal origin. Server-only. Future magic-link URLs must use this, never NEXT_PUBLIC_SITE_URL.
PORTAL_URL=https://portal.phoenixfireplace.ca
DEPLOYMENT_VERSION=local
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
OFFICE_USERNAME=
OFFICE_PASSWORD_HASH=
OFFICE_PASSWORD=
ADMIN_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
# Public article image uploads also use BLOB_READ_WRITE_TOKEN (access: public per upload).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
CRON_SECRET=
BREVO_API_KEY=

# WizField Request Service integration (server-only). Never NEXT_PUBLIC_*.
# Organization is resolved from the credential; do not send organizationId.
WIZFIELD_API_BASE_URL=
WIZFIELD_INTEGRATION_SECRET=

# Google Search Console (HTML tag verification)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (gtag.js)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Google Tag Gateway first-party path (must match Cloudflare gateway endpoint)
# Enable gateway in Cloudflare first, then set the same path here (e.g. /metrics).
# Use setUpTag: false in Cloudflare so this app loads the tag (keeps Next.js page tracking).
# NEXT_PUBLIC_GA_GATEWAY_PATH=/metrics

# Weather uses Environment and Climate Change Canada (MSC GeoMet). No API key.
# Recommendation rules stay off until thresholds are validated. Cache still refreshes hourly.
# WEATHER_RULES_ENABLED=

# Weather article strip (content routing, not risk scoring). Default off.
# Set to true to show a matching published article CTA in the header weather strip.
# WEATHER_ARTICLE_STRIP_ENABLED=

# Browser Google Maps key for Address Selection (legacy Place Autocomplete + map pin).
# Never use an unrestricted key. Do not commit a live key.
# Google Cloud Console > APIs & Services > Credentials > this key:
#   Application restriction: HTTP referrers (websites) only
#   Referrers:
#     https://phoenixfireplace.ca/*
#     https://www.phoenixfireplace.ca/*
#     https://<staging-host>/*   (dedicated staging host only; not *.vercel.app)
#     http://localhost:3000/*    (development key only)
#   API restriction: restrict key, enable only:
#     Maps JavaScript API
#     Places API          ← required for Autocomplete (the Address Selection widget)
# Places API (New) is not used by this form. Localhost belongs on a separate
# development key, not the production key.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional extra hostnames for staging (comma-separated host or URL):
# NEXT_PUBLIC_GOOGLE_MAPS_ALLOWED_HOSTS=

# Owner-verified Google rating for public display (never fabricate)
# GOOGLE_RATING=
# GOOGLE_REVIEW_COUNT=
# BUSINESS_STREET_ADDRESS=
# BUSINESS_ADDRESS_LOCALITY=
# BUSINESS_ADDRESS_REGION=AB
# BUSINESS_ADDRESS_POSTAL_CODE=
# BUSINESS_ADDRESS_COUNTRY=CA
# BUSINESS_GEO_LATITUDE=
# BUSINESS_GEO_LONGITUDE=
# GOOGLE_BUSINESS_PROFILE_URL=
# BUSINESS_SAME_AS_URLS=https://example.com/social-profile

# Optional comma-separated usernames allowed to open WETT reports.
# When empty, every admin and office account can create and resume reports.
WETT_REPORT_USERNAMES=
# Optional internal copy for a completed WETT report email. Server-only.
WETT_INTERNAL_REPORT_EMAIL=